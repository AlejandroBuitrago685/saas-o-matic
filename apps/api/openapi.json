{
  "openapi": "3.1.0",
  "info": {
    "title": "SaaS-O-Matic API",
    "version": "1.0.0",
    "description": "Contract: ai-workspace/02-especificacion/04-contrato-api.md. Errors are RFC 9457 Problem Details."
  },
  "components": {
    "schemas": {}
  },
  "paths": {
    "/catalog": {
      "get": {
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "countries": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "code": {
                            "type": "string",
                            "enum": [
                              "ES",
                              "PT",
                              "FR",
                              "DE",
                              "IT",
                              "GB",
                              "US"
                            ]
                          },
                          "taxRateBps": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 10000
                          },
                          "taxIdTypes": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "enum": [
                                "DNI",
                                "NIE",
                                "CIF",
                                "VAT",
                                "EIN"
                              ]
                            }
                          },
                          "taxIdPrefix": {
                            "type": [
                              "string",
                              "null"
                            ]
                          }
                        },
                        "required": [
                          "code",
                          "taxRateBps",
                          "taxIdTypes",
                          "taxIdPrefix"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "plans": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "code": {
                            "type": "string",
                            "enum": [
                              "STARTER",
                              "BUSINESS",
                              "ENTERPRISE"
                            ]
                          },
                          "tariffCode": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "code",
                          "tariffCode"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "tariffs": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "code": {
                            "type": "string"
                          },
                          "currency": {
                            "type": "string",
                            "enum": [
                              "EUR"
                            ]
                          },
                          "tiers": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "tier": {
                                  "type": "integer",
                                  "exclusiveMinimum": 0,
                                  "maximum": 9007199254740991
                                },
                                "fromUser": {
                                  "type": "integer",
                                  "exclusiveMinimum": 0,
                                  "maximum": 9007199254740991
                                },
                                "toUser": {
                                  "anyOf": [
                                    {
                                      "type": "integer",
                                      "exclusiveMinimum": 0,
                                      "maximum": 9007199254740991
                                    },
                                    {
                                      "type": "null"
                                    }
                                  ]
                                },
                                "unitPriceCents": {
                                  "type": "integer",
                                  "exclusiveMinimum": 0,
                                  "maximum": 9007199254740991
                                }
                              },
                              "required": [
                                "tier",
                                "fromUser",
                                "toUser",
                                "unitPriceCents"
                              ],
                              "additionalProperties": false
                            }
                          }
                        },
                        "required": [
                          "code",
                          "currency",
                          "tiers"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "limits": {
                      "type": "object",
                      "properties": {
                        "activeUsers": {
                          "type": "object",
                          "properties": {
                            "min": {
                              "type": "integer",
                              "minimum": -9007199254740991,
                              "maximum": 9007199254740991
                            },
                            "max": {
                              "type": "integer",
                              "minimum": -9007199254740991,
                              "maximum": 9007199254740991
                            }
                          },
                          "required": [
                            "min",
                            "max"
                          ],
                          "additionalProperties": false
                        },
                        "storageGb": {
                          "type": "object",
                          "properties": {
                            "min": {
                              "type": "integer",
                              "minimum": -9007199254740991,
                              "maximum": 9007199254740991
                            },
                            "max": {
                              "type": "integer",
                              "minimum": -9007199254740991,
                              "maximum": 9007199254740991
                            }
                          },
                          "required": [
                            "min",
                            "max"
                          ],
                          "additionalProperties": false
                        },
                        "apiCallsPerMonth": {
                          "type": "object",
                          "properties": {
                            "min": {
                              "type": "integer",
                              "minimum": -9007199254740991,
                              "maximum": 9007199254740991
                            },
                            "max": {
                              "type": "integer",
                              "minimum": -9007199254740991,
                              "maximum": 9007199254740991
                            }
                          },
                          "required": [
                            "min",
                            "max"
                          ],
                          "additionalProperties": false
                        },
                        "companyName": {
                          "type": "object",
                          "properties": {
                            "min": {
                              "type": "integer",
                              "minimum": -9007199254740991,
                              "maximum": 9007199254740991
                            },
                            "max": {
                              "type": "integer",
                              "minimum": -9007199254740991,
                              "maximum": 9007199254740991
                            }
                          },
                          "required": [
                            "min",
                            "max"
                          ],
                          "additionalProperties": false
                        },
                        "contactEmail": {
                          "type": "object",
                          "properties": {
                            "max": {
                              "type": "integer",
                              "minimum": -9007199254740991,
                              "maximum": 9007199254740991
                            }
                          },
                          "required": [
                            "max"
                          ],
                          "additionalProperties": false
                        },
                        "taxId": {
                          "type": "object",
                          "properties": {
                            "min": {
                              "type": "integer",
                              "minimum": -9007199254740991,
                              "maximum": 9007199254740991
                            },
                            "max": {
                              "type": "integer",
                              "minimum": -9007199254740991,
                              "maximum": 9007199254740991
                            }
                          },
                          "required": [
                            "min",
                            "max"
                          ],
                          "additionalProperties": false
                        },
                        "searchQuery": {
                          "type": "object",
                          "properties": {
                            "max": {
                              "type": "integer",
                              "minimum": -9007199254740991,
                              "maximum": 9007199254740991
                            }
                          },
                          "required": [
                            "max"
                          ],
                          "additionalProperties": false
                        },
                        "pageSize": {
                          "type": "object",
                          "properties": {
                            "default": {
                              "type": "integer",
                              "minimum": -9007199254740991,
                              "maximum": 9007199254740991
                            },
                            "max": {
                              "type": "integer",
                              "minimum": -9007199254740991,
                              "maximum": 9007199254740991
                            }
                          },
                          "required": [
                            "default",
                            "max"
                          ],
                          "additionalProperties": false
                        }
                      },
                      "required": [
                        "activeUsers",
                        "storageGb",
                        "apiCallsPerMonth",
                        "companyName",
                        "contactEmail",
                        "taxId",
                        "searchQuery",
                        "pageSize"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "countries",
                    "plans",
                    "tariffs",
                    "limits"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    }
                  },
                  "required": [
                    "status"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "503": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "unavailable"
                      ]
                    }
                  },
                  "required": [
                    "status"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    }
  }
}
