# Environment variables of the API (03-arquitectura/03-backend.md §5). Every variable is optional and validated
# at startup. Nothing loads a file automatically: export them in your shell or in Docker Compose, or copy this
# file to `.env` and start Node with `--env-file=.env`. Never commit a real `.env`.

# Network
HOST=127.0.0.1
PORT=3000

# Logging: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# The following variables are introduced in P3 (database, CORS, rate limits, demo mode):
# NODE_ENV=development
# DATABASE_PATH=./data/saas-o-matic.db
# CORS_ORIGINS=http://localhost:4200
# RATE_LIMIT_PER_MINUTE=100
# RATE_LIMIT_WRITES_PER_MINUTE=20
# TRUST_PROXY=false
# DEMO_MODE=false
