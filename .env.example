# Environment variables of the API (03-arquitectura/03-backend.md §5). Every variable is optional and validated
# at startup: an invalid value stops the process and names the variable, never its value. Nothing loads a file
# automatically: export them in your shell or in Docker Compose, or copy this file to `.env` and start Node with
# `--env-file=.env`. Never commit a real `.env`.

# development | test | production. Development pretty-prints the logs and serves Swagger UI at /docs.
NODE_ENV=development

# Network
HOST=127.0.0.1
PORT=3000

# SQLite file (its folder is created if missing). `:memory:` is only accepted with NODE_ENV=test.
DATABASE_PATH=./data/saas-o-matic.db

# Origins allowed by CORS, comma-separated: scheme://host[:port], no `*`.
CORS_ORIGINS=http://localhost:4200

# Requests per client IP and minute: all of them, and POST only (D-44; 5 writes in the demo).
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_WRITES_PER_MINUTE=20

# Proxies whose X-Forwarded-For is trusted to find the real client IP (D-105, D-113): `false` without a proxy, or a
# comma-separated list of addresses, CIDR ranges or `loopback`. Never `true`, a number of hops nor a whole private
# range a client could be in. Behind the Docker network of the demo, its subnet (P6), e.g. 172.30.0.0/24.
TRUST_PROXY=false

# Logging: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Demo mode (08-despliegue §4): data reset at startup, from P11. The demo limits are the variables above.
DEMO_MODE=false
