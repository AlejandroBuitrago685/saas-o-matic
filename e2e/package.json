    "test:demo": "playwright test -c playwright.demo.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@saas-o-matic/contract": "0.0.0"
  }
}
